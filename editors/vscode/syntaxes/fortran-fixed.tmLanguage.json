{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "IBM Legacy FORTRAN (fixed form)",
  "scopeName": "source.fortran.ibmlegacy",
  "fileTypes": ["f", "for", "ftn", "f77"],
  "patterns": [
    { "include": "#comment" },
    { "include": "#label" },
    { "include": "#continuation" },
    { "include": "#string" },
    { "include": "#number" },
    { "include": "#format" },
    { "include": "#declaration" },
    { "include": "#statement" },
    { "include": "#intrinsic" },
    { "include": "#operator" }
  ],
  "repository": {
    "comment": {
      "comment": "Fixed-form comment: column 1 is C, c, * or !",
      "match": "^([Cc*!].*)$",
      "name": "comment.line.fortran.ibmlegacy"
    },
    "label": {
      "comment": "Statement label field, columns 1-5",
      "match": "^([ 0-9]{5})(?=[^ Cc*!])",
      "captures": { "1": { "name": "constant.numeric.label.fortran.ibmlegacy" } }
    },
    "continuation": {
      "comment": "Continuation column, column 6",
      "match": "^([ 0-9]{5})([^ 0])(?=.*\\S)",
      "captures": { "2": { "name": "keyword.control.continuation.fortran.ibmlegacy" } }
    },
    "format": {
      "match": "\\b(FORMAT)\\b\\s*(\\([^)]*\\))",
      "captures": {
        "1": { "name": "keyword.control.format.fortran.ibmlegacy" },
        "2": { "name": "string.quoted.other.format.fortran.ibmlegacy" }
      }
    },
    "declaration": {
      "match": "(?i)\\b(INTEGER|REAL|DOUBLE\\s+PRECISION|LOGICAL|COMPLEX|CHARACTER|DIMENSION|COMMON|EQUIVALENCE|EXTERNAL|INTRINSIC|PARAMETER|DATA|IMPLICIT|SAVE)\\b",
      "name": "storage.type.fortran.ibmlegacy"
    },
    "statement": {
      "match": "(?i)\\b(PROGRAM|END|STOP|PAUSE|CONTINUE|RETURN|CALL|SUBROUTINE|FUNCTION|BLOCK\\s+DATA|DO|IF|THEN|ELSE|ELSE\\s+IF|END\\s+IF|GO\\s+TO|GOTO|ASSIGN|READ|WRITE|PRINT|REWIND|BACKSPACE|ENDFILE)\\b",
      "name": "keyword.control.fortran.ibmlegacy"
    },
    "intrinsic": {
      "match": "(?i)\\b(ABS|SQRT|EXP|LOG|LOG10|SIN|COS|TAN|ATAN|ASIN|ACOS|INT|IFIX|FLOAT|SIGN|MOD|AMOD|MIN|MAX|AMIN1|AMAX1|DSQRT|DEXP|DABS)\\b",
      "name": "support.function.intrinsic.fortran.ibmlegacy"
    },
    "string": {
      "match": "'([^']|'')*'|\"([^\"]|\"\")*\"",
      "name": "string.quoted.fortran.ibmlegacy"
    },
    "number": {
      "match": "\\b\\d+(\\.\\d*)?([eEdD][+-]?\\d+)?\\b",
      "name": "constant.numeric.fortran.ibmlegacy"
    },
    "operator": {
      "match": "\\*\\*|//|[+\\-*/=<>]|\\.(EQ|NE|LT|LE|GT|GE|AND|OR|NOT|TRUE|FALSE)\\.(?i)",
      "name": "keyword.operator.fortran.ibmlegacy"
    }
  }
}
